rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function exact(fields) { return request.resource.data.keys().hasOnly(fields); }
    function relationship(rid) { return get(/databases/$(database)/documents/relationships/$(rid)).data; }
    function member(rid) { return signedIn() && request.auth.uid in relationship(rid).memberUids; }
    function validUser() { return exact(['activeRelationshipId','activeInvitationHash','updatedAt']) && (request.resource.data.activeRelationshipId == null || request.resource.data.activeRelationshipId is string) && (request.resource.data.activeInvitationHash == null || request.resource.data.activeInvitationHash is string) && request.resource.data.updatedAt == request.time; }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validUser() && !request.resource.data.keys().hasAny(['admin','role','privateKey']);
      allow delete: if isSelf(uid) && resource.data.activeRelationshipId == null;
    }
    match /devices/{deviceId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || (resource.data.relationshipId is string && member(resource.data.relationshipId)));
      allow create: if signedIn() && exact(['ownerUid','relationshipId','publicKey','algorithm','fingerprint','createdAt','revokedAt']) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.publicKey is string && request.resource.data.publicKey.size() < 256 && request.resource.data.algorithm == 'ECDH-P256' && request.resource.data.createdAt == request.time && request.resource.data.revokedAt == null;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']) && request.resource.data.revokedAt == request.time;
      allow delete: if false;
    }
    match /invitations/{invitationHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && invitationHash.matches('^[0-9a-f]{64}$') && exact(['creatorUid','status','createdAt','expiresAt','redeemerUid']) && request.resource.data.creatorUid == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(10, 'm') && request.resource.data.redeemerUid == null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRelationshipId == null;
      allow update: if signedIn() && request.resource.data.creatorUid == resource.data.creatorUid && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.expiresAt == resource.data.expiresAt && ((resource.data.creatorUid == request.auth.uid && resource.data.status == 'open' && request.resource.data.status == 'cancelled') || (resource.data.creatorUid != request.auth.uid && resource.data.status == 'open' && resource.data.expiresAt > request.time && request.resource.data.status == 'redeemed' && request.resource.data.redeemerUid == request.auth.uid));
      allow delete: if false;
    }
    match /relationships/{rid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && exact(['memberUids','confirmedUids','status','createdAt','revokedAt','revokedBy','invitationHash']) && request.resource.data.memberUids is list && request.resource.data.memberUids.size() == 2 && request.resource.data.memberUids[0] != request.resource.data.memberUids[1] && request.auth.uid in request.resource.data.memberUids && request.resource.data.confirmedUids == [request.auth.uid] && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.revokedAt == null && request.resource.data.revokedBy == null && request.resource.data.invitationHash is string && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationHash)).data.status == 'redeemed' && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationHash)).data.creatorUid in request.resource.data.memberUids && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationHash)).data.redeemerUid == request.auth.uid && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationHash)).data.relationshipId == rid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRelationshipId == null;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids && request.resource.data.memberUids == resource.data.memberUids && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.invitationHash == resource.data.invitationHash && ((resource.data.status == 'pending' && request.resource.data.status in ['pending','active'] && request.resource.data.confirmedUids.size() <= 2 && request.resource.data.confirmedUids.hasOnly(resource.data.memberUids)) || (resource.data.status in ['pending','active'] && request.resource.data.status == 'revoked' && request.resource.data.revokedBy == request.auth.uid && request.resource.data.revokedAt == request.time));
      allow delete: if false;
      match /envelopes/{envelopeId} {
        allow read: if member(rid) && resource.data.recipientUid == request.auth.uid;
        allow create: if member(rid) && relationship(rid).status == 'active' && exact(['version','envelopeId','relationshipId','senderUid','recipientUid','contentType','createdAt','expiresAt','nonce','ciphertext']) && envelopeId == request.resource.data.envelopeId && request.resource.data.relationshipId == rid && request.resource.data.senderUid == request.auth.uid && request.resource.data.recipientUid in relationship(rid).memberUids && request.resource.data.recipientUid != request.auth.uid && request.resource.data.version == 1 && request.resource.data.contentType in ['message','emotion','response','signal','ritual'] && request.resource.data.nonce is string && request.resource.data.nonce.size() <= 32 && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() <= 16384 && request.resource.data.createdAt <= request.time && request.resource.data.createdAt > request.time - duration.value(5,'m') && request.resource.data.expiresAt <= request.time + duration.value(7,'d');
        allow update, delete: if false;
      }
      match /acknowledgements/{envelopeId} {
        allow read: if member(rid);
        allow create: if member(rid) && exact(['envelopeId','recipientUid','deliveredAt']) && request.resource.data.envelopeId == envelopeId && request.resource.data.recipientUid == request.auth.uid && request.resource.data.deliveredAt == request.time && get(/databases/$(database)/documents/relationships/$(rid)/envelopes/$(envelopeId)).data.recipientUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /pairingSecurity/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && exact(['failedAttempts','lockedUntil','updatedAt']) && request.resource.data.failedAttempts in [0,1] && request.resource.data.lockedUntil == null && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid) && exact(['failedAttempts','lockedUntil','updatedAt']) && request.resource.data.updatedAt == request.time && ((request.resource.data.failedAttempts == resource.data.failedAttempts + 1 && (request.resource.data.lockedUntil == resource.data.lockedUntil || (request.resource.data.failedAttempts >= 3 && request.resource.data.lockedUntil >= request.time + duration.value(24,'h')))) || (request.resource.data.failedAttempts == 0 && request.resource.data.lockedUntil == null && (resource.data.lockedUntil == null || resource.data.lockedUntil <= request.time)));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
